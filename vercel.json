{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "GEMINI_API_KEY": "AIzaSyDVue17abUe5klEfzKDxYTXHx26IxuRd28"
  },
  "build": {
    "env": {
      "GEMINI_API_KEY": "AIzaSyDVue17abUe5klEfzKDxYTXHx26IxuRd28"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
